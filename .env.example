# Copy to `.env.local` to override. Never commit .env.local.

# Where the Vite dev server forwards /api and /health requests.
# The browser talks to Vite, Vite talks to FastAPI, so no CORS changes are needed in the backend.
VITE_BACKEND_URL=http://localhost:8000

# "live" = real FastAPI backend, "mock" = built-in demo data (no backend/Unity needed).
# You can also add ?mock=1 to the URL at any time.
VITE_DATA_SOURCE=live
